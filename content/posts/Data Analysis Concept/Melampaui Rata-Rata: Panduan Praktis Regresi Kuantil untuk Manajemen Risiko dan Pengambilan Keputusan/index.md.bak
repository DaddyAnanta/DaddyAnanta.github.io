    A["Problem Bisnis:<br>Strategi Harga Mana yang Terbaik?"]:::process;
    B{"Data Tersedia:<br>Penjualan, Strategi,<br>Anggaran Iklan"}:::decision;
    C["Eksplorasi Data Awal<br>& Visualisasi"]:::process;
    D{"Identifikasi Covariate:<br>Anggaran Iklan Mengaburkan<br>Efek Harga"}:::decision;
    E["Pilih Metodologi: ANCOVA"]:::process;
    F["Pemeriksaan Asumsi Kunci<br>(e.g., Homogenitas Lereng Regresi)"]:::process;
    G["Fit Model ANCOVA<br><pre><code>penjualan ~ iklan + C(strategi)</code></pre>"]:::process;
    H["Interpretasi Output Model<br>(Koefisien & Signifikansi)"]:::process;
    I{"Apakah Efek Strategi Signifikan<br>Secara Keseluruhan?"}:::decision;
    J["Lakukan Uji Post-Hoc (Tukey HSD)<br>Identifikasi Pasangan yang Berbeda"]:::recommendation;
    K["❗ Stop: Tidak ada bukti perbedaan<br>antar strategi"]:::warning;
    L["Hitung & Visualisasikan<br>Adjusted Means"]:::process;
    M["Kuantifikasi Dampak Bisnis<br>(Proyeksi Lift & ROI)"]:::process;
    N["✅ Susun Narasi & Rekomendasi<br>untuk Stakeholder"]:::success;
